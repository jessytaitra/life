# ===== Microsoft 365 / Graph 連線設定 =====
# 將此檔複製成 .env 後填入你的值 (詳見 README.md)

# Azure 應用程式 (用戶端) 識別碼
VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Azure 目錄 (租用戶) 識別碼,或填 common
VITE_MS_TENANT_ID=common

# 登入後導回的網址 (需與 Azure 設定一致)
VITE_MS_REDIRECT_URI=http://localhost:5173

# 存放訂單的 Excel 檔在 OneDrive/SharePoint 上的 item id
VITE_EXCEL_ITEM_ID=

# Excel 內工作表上的「表格」名稱 (預設 Orders)
VITE_EXCEL_TABLE_NAME=Orders
